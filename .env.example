# Onde ficam banco, chave e saídas (default: ./data)
# CAPIVARA_CLOUD_DATA=./data

# Banco SQLite e chave Fernet (default: data/cloud.db e data/cloud.key)
# CAPIVARA_CLOUD_BANCO=./data/cloud.db
# CAPIVARA_CLOUD_CHAVE=./data/cloud.key

# Chave Fernet pronta (alternativa ao arquivo; gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CAPIVARA_CLOUD_KEY=

# Servidor local
CAPIVARA_CLOUD_HOST=127.0.0.1
CAPIVARA_CLOUD_PORTA=8787

# Permite chamadas HTTP para localhost/redes privadas.
# Deixe false em produção para evitar SSRF.
CAPIVARA_CLOUD_PERMITIR_REDE_LOCAL=false

# Agendamentos recorrentes (thread no próprio servidor)
CAPIVARA_CLOUD_AGENDADOR=true
CAPIVARA_CLOUD_INTERVALO_AGENDADOR=60
CAPIVARA_CLOUD_FUSO=America/Sao_Paulo

# Copilot de fluxos (BYOK por padrão; a chave do navegador não é gravada)
# CAPIVARA_IA_PROVIDER=openai
# CAPIVARA_IA_BASE_URL=https://api.openai.com/v1
# CAPIVARA_IA_MODELO=gpt-4o-mini
# CAPIVARA_IA_TIMEOUT=60
# Opcional: chave no servidor (custo/abuso por conta de quem configurou)
# CAPIVARA_AI_KEY=
